# Configure ONLY in the hosting provider's encrypted server environment settings.
SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_SAME_PROJECT_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SECRET_MANAGER
SITE_ORIGIN=https://YOUR-STAGING-DOMAIN.example
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CRON_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
META_ACCESS_TOKEN=REPLACE_IN_SECRET_MANAGER
META_PIXEL_ID=568351333004084
META_API_VERSION=v26.0
# Both browser and server delivery are disabled until explicitly enabled.
META_ENABLED=false
META_MODE=test
# Required in test mode. Use an isolated test dataset and Pixel ID while staging.
META_TEST_EVENT_CODE=REPLACE_WITH_TEST_EVENTS_CODE
# Live: META_MODE=live, empty META_TEST_EVENT_CODE, production VERCEL_ENV required.
